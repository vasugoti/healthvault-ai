# HealthVault AI Backend Environment Variables Template
# Copy this file to backend/.env and update values as needed

# Database
DATABASE_URL=postgresql+asyncpg://healthvault:healthvault_secret@127.0.0.1:5433/healthvaultdb

# Redis Cache & Celery Task Broker
REDIS_URL=redis://localhost:6379/0

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=healthvault-documents
MINIO_SECURE=false

# JWT Authentication
JWT_SECRET_KEY=change_me_in_production_secret_key_12345
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000

# App Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Optional SMTP Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=HealthVault AI
