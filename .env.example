# HealthVault AI Environment Variables
# Copy this file to .env and fill in the values

# --- PostgreSQL ---
POSTGRES_USER=healthvault
POSTGRES_PASSWORD=healthvault_secret
POSTGRES_DB=healthvaultdb
DATABASE_URL=postgresql+asyncpg://healthvault:healthvault_secret@localhost:5432/healthvaultdb

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=healthvault-documents
MINIO_SECURE=false

# --- JWT Auth ---
JWT_SECRET_KEY=change_me_to_a_very_long_random_secret_key_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,https://healthvault-ai.vercel.app

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
